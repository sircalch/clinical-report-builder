# Public site identity
NEXT_PUBLIC_SITE_URL=https://clinical-report-builder.vercel.app
NEXT_PUBLIC_CORE_URL=https://biomedtools-mx-core.vercel.app

# Public links to related BioMedTools MX modules
NEXT_PUBLIC_QUIZ_ARENA_URL=https://biomed-quiz-arena.vercel.app
